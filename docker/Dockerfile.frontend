# ==========================================
# Stage 1: Build the Angular Application
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies using clean install for reproducible builds
COPY frontend/package*.json ./
RUN npm ci

# Copy application source code
COPY frontend/ ./

# Compile production bundle (generates output in dist/frontend/browser)
RUN npm run build

# ==========================================
# Stage 2: Production Nginx Server
# ==========================================
FROM nginx:alpine

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy custom Nginx configuration with reverse proxy and security headers
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Copy compiled frontend assets from builder stage
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Health check to ensure Nginx is responding
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
